{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @fel/web build"
  },
  "deploy": {
    "startCommand": "NODE_ENV=production pnpm --filter @fel/web start --hostname 0.0.0.0 --port \"$PORT\"",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
