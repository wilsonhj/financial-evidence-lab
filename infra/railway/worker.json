{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bash scripts/runtime/install.sh"
  },
  "deploy": {
    "preDeployCommand": "python scripts/db/migrate.py --check --database-url \"$FEL_DATABASE_URL\"",
    "startCommand": "python -m fel_workers run",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
