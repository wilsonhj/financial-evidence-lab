{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bash scripts/runtime/install.sh"
  },
  "deploy": {
    "preDeployCommand": "python scripts/db/migrate.py --check --database-url \"${FEL_MIGRATION_DATABASE_URL:-$FEL_DATABASE_URL}\"",
    "startCommand": "env -u FEL_MIGRATION_DATABASE_URL FEL_WORKER_DB_ROLE=fel_worker python -m fel_workers run",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
