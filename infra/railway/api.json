{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "bash scripts/runtime/install.sh"
  },
  "deploy": {
    "preDeployCommand": "python scripts/db/migrate.py --database-url \"$FEL_DATABASE_URL\"",
    "startCommand": "uvicorn app.main:app --host 0.0.0.0 --port $PORT --app-dir apps/api",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
