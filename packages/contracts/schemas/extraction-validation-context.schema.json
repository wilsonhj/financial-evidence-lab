{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fel.dev/schemas/extraction-validation-context/v1",
  "x-fel-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_version",
    "normalizer_version",
    "validator_version",
    "unit_policy_version",
    "range_policy_version",
    "source_runs"
  ],
  "properties": {
    "schema_version": {
      "const": "extraction-validation-context/v1"
    },
    "workflow_version": {
      "type": "string"
    },
    "normalizer_version": {
      "type": "string"
    },
    "validator_version": {
      "type": "string"
    },
    "unit_policy_version": {
      "type": "string"
    },
    "range_policy_version": {
      "type": "string"
    },
    "source_runs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "as_of",
          "corpus_version_id",
          "ontology_version",
          "workflow_version",
          "policy_id"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "as_of": {
            "type": "string",
            "format": "date-time"
          },
          "corpus_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "ontology_version": {
            "type": "string"
          },
          "workflow_version": {
            "type": "string"
          },
          "policy_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
