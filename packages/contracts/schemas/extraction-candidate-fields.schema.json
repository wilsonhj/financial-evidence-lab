{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.fel.dev/schemas/extraction-candidate-fields/v1",
  "x-fel-version": "1.0.0",
  "title": "ExtractionCandidateFields",
  "description": "Read-only public candidate fields as persisted PostgreSQL JSON text. Render strings verbatim; do not parse, use for financial hashing, infer approval, or convert automatically into mutation inputs. Embedded JSON syntax is guaranteed by the producer, not structural schema validation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fields"],
  "properties": {
    "schema_version": {
      "const": "extraction-candidate-fields/v1"
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "description": "Only present public financial keys; missing keys remain absent and present JSON null is the string null. Unknown and internal control fields are omitted. The persisted field JSON representation, including quotes for JSON strings. Overlong values produce a typed 413; never truncate.",
      "properties": {
        "category": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "currency": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "definition": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "description": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "dimensions": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "direction": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "entity_id": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "high": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "issuer_label": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "kind": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "low": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "metric_id": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "period": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "qualifiers": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "raw_value": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
