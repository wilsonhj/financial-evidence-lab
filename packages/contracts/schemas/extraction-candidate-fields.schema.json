          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "target_metric_ids": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
        "text": {
          "type": "string",
          "maxLength": 65536,
          "contentMediaType": "application/json"
        },
